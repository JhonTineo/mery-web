# Optional: final production origin, for canonical and Open Graph URLs.
# PUBLIC_SITE_URL=https://your-domain.com

# Optional: custom QR destination. Defaults to PUBLIC_SITE_URL, then Vercel's
# production domain (or deployment URL). Local preview is clearly labeled.
# PUBLIC_QR_URL=https://your-domain.com

# Optional: public HTTPS URL of an actual Android release. Leave blank until ready.
# PUBLIC_DOWNLOAD_URL=https://example.com/mery.apk
